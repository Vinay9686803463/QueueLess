# Copy this file to backend/.env and replace every placeholder value.
# Never commit backend/.env.

# Production or primary application database.
DATABASE_URL=postgresql://username:password@host:5432/database

# Separate test database. Required before running integration tests.
# This must not point to the production database.
TEST_DATABASE_URL=postgresql://username:password@host:5432/database_test

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=False
FLASK_ENV=development
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_TOKEN_EXPIRES=3600

# Gmail SMTP settings required to deliver password-reset OTPs. Use a Gmail
# App Password, never your normal Gmail password. Keep backend/.env untracked.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=